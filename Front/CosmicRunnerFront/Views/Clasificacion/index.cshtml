@model Front.Models.ViewModels.ClasificacionViewModel

@{
    ViewData["Title"] = "Clasificación";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Clasificacion.css" />
}

<body>
<div class="container mt-4" style="background-color: #f7f7f7;">

    <h1 class="fw-bold">Clasificación Global</h1>
    <p class="text-muted">Consulta el desempeño de los colaboradores a nivel global y departamental</p>
    <br />

    <div class="card custom-card mb-5 p-4">

        <div class="d-flex align-items-center mb-4">
            <div class="icon-circle me-2">
                <img src="~/assets/ImagenesClasificacion/ClasificacionGlobal.png" />
            </div>
            <h4 class="mb-0">Clasificación Global</h4>
        </div>

        @if (Model.Global.Count == 0)
        {
            <div class="alert alert-warning mb-0">
                No se encontraron usuarios.
            </div>
        }
        else
        {
            @foreach (var user in Model.Global)
            {
                <div class="ranking-item d-flex">

                    <div class="position-box position-@user.Posicion">
                        @user.Posicion
                    </div>

                    <div class="ranking-contentTop d-flex justify-content-between align-items-center w-100 ">

                        <div class="d-flex align-items-center">

                            <img src="~/assets/random/user.png" class="rounded-circle user-img me-3" />

                            <div>
                                <h5 class="mb-1 fw-semibold">@user.Nombre</h5>
                                <small class="text-muted d-flex gap-3">
                                    <span>
                                        <img src="~/assets/ImagenesClasificacion/Prompt.png" class="mini-icon" />
                                        @user.Prompts Prompts
                                    </span>
                                </small>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3">

                            <div class="score-box">
                                <img src="~/assets/ImagenesClasificacion/Flecha.png" class="mini-iconArrow" />
                                @user.Puntaje
                            </div>

                            @if (user.Posicion == 1)
                            {
                                <img src="~/assets/ImagenesClasificacion/PrimerLugar.png" class="trophy-icon" />
                            }
                            else if (user.Posicion == 2)
                            {
                                <img src="~/assets/ImagenesClasificacion/SegundoLugar.png" class="trophy-icon" />
                            }
                            else if (user.Posicion == 3)
                            {
                                <img src="~/assets/ImagenesClasificacion/TercerLugar.png" class="trophy-icon" />
                            }

                        </div>

                    </div>
                </div>
            }
        }

    </div>

    

    <div class="card custom-card p-4">

        <div class="d-flex align-items-center mb-4">
            <div class="icon-circle me-2">
                <img src="~/assets/ImagenesClasificacion/ClasificacionDepartamental.png" />
            </div>
            <h4 class="mb-0">Clasificación Departamental: @Model.DepartamentoSeleccionado</h4>
        </div>
        <div class="d-flex flex-wrap gap-2 mb-3">
            <a class="btn @(string.IsNullOrWhiteSpace(Model.DepartamentoSeleccionado) ? "btn-dark departmentSelection" : "btn-outline-dark department")" asp-route-nombre="@Model.NombreBuscado">Todos</a>
            @foreach (var departamento in Model.Departamentos)
            {
                var esSeleccionado = string.Equals(Model.DepartamentoSeleccionado, departamento, StringComparison.OrdinalIgnoreCase);
                <a class="btn @(esSeleccionado ? "btn-dark departmentSelection" : "btn-outline-dark department")" asp-route-departamento="@departamento" asp-route-nombre="@Model.NombreBuscado">@departamento</a>
            }
        </div>

        <form method="get" class="row g-3 mb-3 align-items-end">
            <div class="col-12 col-md-5">
                <label for="nombre" class="form-label fw-semibold" style="color: #313131;">Filtrar por nombre</label>
                <div class="input-group" style="height: 40px; border: 2px solid #505050; border-radius: 8px;">
                    <span class="input-group-text" style="background-color: #ffffff; border-right: 1px solid #505050;">
                        <img src="~/assets/ImagenesClasificacion/Buscar.png" style="width: 20px; height: 20px;" />
                    </span>
                    <input id="nombre" name="nombre" value="@Model.NombreBuscado" class="form-control" style="height: 100%; border: none; box-shadow: none;" type="text" minlength="3" maxlength="50" placeholder="Ej. Jacobo Perez" />
                </div>
            </div>

            <div class="col-12 col-md-2 d-grid">
                <button type="submit" class="btn btn-dark" style="height: 40px;">Buscar</button>
            </div>
        </form>

        @if (Model.Departamental.Count == 0)
        {
            <div class="alert alert-warning warning mb-0">
                No se encontraron usuarios que coincidan con el filtro en el departamento seleccionado.
            </div>
        }
        else
        {
            <div class="departamental-results-container">
                @foreach (var user in Model.Departamental)
                {
                    <div class="ranking-item simple d-flex">

                        <div class="position-box simple position-@user.Posicion">
                            @user.Posicion
                        </div>

                        <div class="ranking-content d-flex justify-content-between align-items-center w-100">

                            <div class="d-flex align-items-center">

                                <img src="~/assets/ImagenesClasificacion/UserImage.png" class="rounded-circle user-img me-3" />

                                <div>
                                    <h5 class="mb-1 fw-semibold">@user.Nombre</h5>
                                    <small class="text-muted d-flex gap-3">
                                        <span>
                                            <img src="~/assets/ImagenesClasificacion/Prompt.png" class="mini-icon" />
                                            @user.Prompts Prompts
                                        </span>
                                    </small>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-3">

                                <div class="score-box">
                                    <img src="~/assets/ImagenesClasificacion/Flecha.png" class="mini-iconArrow" />
                                    @user.Puntaje
                                </div>

                            </div>

                        </div>
                    </div>
                }
            </div>

            @if (Model.TotalPaginas > 1)
            {
                <div class="pagination-controls mt-4">
                    <div class="pagination-button @(Model.PaginaActual <= 1 ? "disabled" : "")">
                        @if (Model.PaginaActual > 1)
                        {
                            <a asp-route-departamento="@Model.DepartamentoSeleccionado" asp-route-nombre="@Model.NombreBuscado" asp-route-page="@(Model.PaginaActual - 1)">
                                <img src="~/assets/ImagenesClasificacion/Pagina1.png" alt="Anterior" style="width: 24px; height: 24px;" />
                            </a>
                        }
                        else
                        {
                            <img src="~/assets/ImagenesClasificacion/Pagina1.png" alt="Anterior" style="width: 24px; height: 24px; opacity: 0.3;" />
                        }
                    </div>

                    <span class="pagination-info">@Model.PaginaActual / @Model.TotalPaginas</span>

                    <div class="pagination-button @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                        @if (Model.PaginaActual < Model.TotalPaginas)
                        {
                            <a asp-route-departamento="@Model.DepartamentoSeleccionado" asp-route-nombre="@Model.NombreBuscado" asp-route-page="@(Model.PaginaActual + 1)">
                                <img src="~/assets/ImagenesClasificacion/Pagina2.png" alt="Siguiente" style="width: 24px; height: 24px;" />
                            </a>
                        }
                        else
                        {
                            <img src="~/assets/ImagenesClasificacion/Pagina2.png" alt="Siguiente" style="width: 24px; height: 24px; opacity: 0.3;" />
                        }
                    </div>
                </div>
            }
        }

    </div>


</div>
</body>