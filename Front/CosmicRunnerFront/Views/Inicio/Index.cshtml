@{
    ViewData["Title"] = "Impulsa el Cambio - Codex";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}

@section Styles {
    <link rel="stylesheet" href="~/css/Inicio/inicio.css" />
}
<body>
    <div class="container-fluid">
        <div class="row g-4 contenedor-principal">
            <div class="col-12 col-md-3">
                <div class="contenedor-perfil">
                    <div class="contenedor-perfil-foto">
                        <img src="~/assets/random/user.png" alt="Foto de perfil">
                    </div>
                    <div class="contenedor-perfil-contenido">
                        <h1>César Alexandro</h1>
                        
                        <div class="estadisticas container my-4">
                            <div class="row mb-2"> <!-- mb-3 = margen inferior -->
                                <div class="col-12 text-center"> <!-- text-center = texto centrado -->
                                    <p>Racha Whirlpool</p>
                                </div>
                            </div>
                            <div class="row mb-3"> <!-- mb-3 = margen inferior -->
                                <div class="col-3 text-center"></div>
                                <div class="col-3 text-center"> <!-- text-center = texto centrado -->
                                    <h3 class="numero-denso">U</h3>
                                </div>
                                <div class="col-3 text-center"> <!-- text-center = texto centrado -->
                                    <h3 class="numero-denso">24</h3>
                                </div>
                                <div class="col-3 text-center"></div>
                            </div>
                        </div>

                        <div class="estadisticas container my-4 ">
                            <div class="row mb-1"> 
                                <div class="col-12 text-center"> 
                                    <p>Posición</p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6 text-center"> 
                                    <h3 class="numero-denso-posicion">50%</h3>
                                </div>
                                <div class="col-6 text-center"> 
                                    <h3 class="numero-denso-posicion">10%</h3>
                                </div>
                            </div>
                            <div class="row mb-3 pb-4">
                                <div class="col-6 text-center"> 
                                    <span>Global</span>
                                </div>
                                <div class="col-6 text-center"> 
                                    <span>Departamental</span>
                                </div>
                            </div>
                        </div>


                        
                        <div class="my-4">
                            <a href="#" class="boton-pildora">
                                <p class="text-center ms-2">Tiendita</p>
                                <p class="icono-emoji ms-2">⚙️</p>
                            </a>
                        </div>
                    </div>
                    <button class="boton-border-bottom">
                            Opciones
                    </button>
                </div>
            </div>
            <div class="col-12 col-md-9">
                <div class="contenedor-impulsa">
                    
                    <div class="mb-5 clearfix header-impulsa">
                        <h1 class="fw-bold text-dark float-start m-0 pt-1">Impulsa el Cambio</h1>
                        
                        <partial name="Partials/_AgregarIdea" model='ViewData["NuevaIdea"] as CosmicRunnerFront.Models.InicioModels.Idea' />
                    </div>

                    <h3 class="top-semanal-title text-muted mb-4 clear-both">Top Semanal Sugerencias de la Comunidad</h3>

                    <div class="ideas-feed">
                        @if(ViewBag.ListaIdeas != null && ((IEnumerable<CosmicRunnerFront.Models.InicioModels.Idea>)ViewBag.ListaIdeas).Any())
                        {
                            foreach (var idea in ViewBag.ListaIdeas)
                            {
                                <partial name="Partials/_IdeaTarjeta" model="idea" />
                            }
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <h4 class="text-muted">Aún no hay sugerencias en la comunidad.</h4>
                                <p class="text-muted">¡Sé el primero en impulsar el cambio agregando tu idea!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
            

        </div>
    </div>
    
    
</body>


