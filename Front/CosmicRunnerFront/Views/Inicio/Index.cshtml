@model CosmicRunnerFront.Models.InicioModels.InicioViewModel
@{
    ViewData["Title"] = "Impulsa el Cambio - Codex";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
    var usuarioActual = Model.UsuarioActual;
}
@section Styles {
    <link rel="stylesheet" href="~/css/Inicio/inicio.css" />
}

<div class="container-fluid custom-container">
    <div class="row g-4">
        <div class="col-12 col-md-3 sticky-top" style="top: 2rem; align-self: start; z-index: 1020;">
            <div class="contenedor-perfil pb-3">
                <div class="contenedor-perfil-foto">
                    <img src="@(string.IsNullOrEmpty(usuarioActual?.foto_perfil) ? "/assets/random/user.png" : usuarioActual.foto_perfil)" alt="Foto de perfil">
                </div>
                <div class="contenedor-perfil-contenido">
                    <h1>@(usuarioActual?.nombre_completo)</h1>
                    
                    <div class="container my-4">
                        <div class="row"> 
                            <div class="col-12 text-center"> 
                                <p>Racha Whirlpool</p>
                            </div>
                        </div>
                        <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap"> 
                            <div class="flex-shrink-0 pb-1"> 
                                <img src="~/assets/icons/fire.svg" class="racha" />
                            </div>
                            <div class="flex-shrink-0"> 
                                <h3 class="numero-denso">@(usuarioActual?.racha_whirlpool)</h3>
                            </div>
                        </div>
                    </div>

                    <div class="container my-4 ">
                        <div class="row"> 
                            <div class="col-12 text-center"> 
                                <p>Perteneces al Top:</p>
                            </div>
                        </div>
                        <div class="d-flex justify-content-center align-items-center gap-0 flex-wrap">
                            <div class="col-6 text-center"> 
                                <div class="row">
                                    <h3 class="numero-denso-posicion">@(usuarioActual?.top_global_pct)%</h3>
                                </div>
                                <div class="row chiquito">
                                    <p>Global</p>
                                </div>
                            </div>
                            <div class="col-6 text-center"> 
                                <div class="row">
                                    <h3 class="numero-denso-posicion">@(usuarioActual?.top_departamental_pct)%</h3>
                                </div>
                                <div class="row chiquito">
                                    <p>Departamental</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-9">
            <div class="contenedor-impulsa">
                
                <div class="col-12 mb-5 clearfix header-impulsa">
                    <h1 class="m-0 pt-1">Impulsa el Cambio</h1>
                </div>

                <div class="col-12 mb-5 clearfix d-flex justify-content-center">
                    <partial name="Partials/_AgregarIdea" model="Model.NuevaIdea" />
                </div>

                <h3 class="top-semanal-title text-muted mb-4 clear-both"><span>Top</span> Sugerencias de la Comunidad</h3>

                <div class="ideas-feed">
                    @if (Model.ListaIdeas != null && Model.ListaIdeas.Any())
                    {
                        int ranking = 1; 

                        foreach (var idea in Model.ListaIdeas)
                        {
                            <partial name="Partials/_IdeaTarjeta" model="idea" view-data='@new ViewDataDictionary(ViewData) { { "Ranking", ranking } }' />
                            ranking++;
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <h4 class="text-muted">Aún no hay sugerencias en la comunidad.</h4>
                            <p class="text-muted">¡Sé el primero en impulsar el cambio agregando tu idea!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>