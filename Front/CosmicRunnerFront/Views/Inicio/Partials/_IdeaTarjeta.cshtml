@model CosmicRunnerFront.Models.InicioModels.Idea

<div class="tarjeta-idea mb-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0 fw-bold text-dark">@Model.idea_id. @Model.titulo</h3>
        <span class="text-muted fs-6">• @Model.dias_transcurridos días</span>
    </div>

    <div class="tarjeta-info-box mb-4">
        <div class="row text-center text-md-start align-items-center">
            <div class="col-12 col-md-4 d-flex align-items-center justify-content-center justify-content-md-start mb-3 mb-md-0 border-md-end py-2">
                <img src="@(string.IsNullOrEmpty(Model.autor?.foto) ? "/assets/random/user.png" : Model.autor.foto)" alt="Autor" class="avatar-autora me-3">
                <div>
                    <span class="d-block text-muted small">Autor(a):</span>
                    <span class="fw-bold fs-6 text-dark">@(Model.autor?.nombre ?? "Usuario")</span>
                </div>
            </div>
            <div class="col-6 col-md-4 border-md-end py-2 ps-md-4">
                <span class="d-block text-muted small">Departamento</span>
                <span class="fw-bold fs-6 text-dark">@(Model.etiquetas?.departamento ?? "Sin asignar")</span>
            </div>
            <div class="col-6 col-md-4 py-2 ps-md-4">
                <span class="d-block text-muted small">Área de Impacto</span>
                <span class="fw-bold fs-6 text-dark">@(Model.etiquetas?.area_impacto ?? "Sin asignar")</span>
            </div>
        </div>
    </div>

    <div class="text-center mb-3 mt-4">
        <span class="text-muted fs-6">Estado de la Iniciativa</span>
    </div>
    
    <div class="timeline-container mb-4">
        <div class="timeline-track"></div>
        
        <div class="timeline-step">
            <div class="timeline-node @(Model.estado == 0 ? "node-yellow" : (Model.estado > 0 ? "node-black" : "node-grey"))"></div>
            <span class="timeline-label @(Model.estado == 0 ? "fw-bold text-dark" : "text-muted")">En Revisión</span>
        </div>
        <div class="timeline-step">
            <div class="timeline-node @(Model.estado == 1 ? "node-yellow" : (Model.estado > 1 ? "node-black" : "node-grey"))"></div>
            <span class="timeline-label @(Model.estado == 1 ? "fw-bold text-dark" : "text-muted")">Reclutamiento</span>
        </div>
        <div class="timeline-step">
            <div class="timeline-node @(Model.estado == 2 ? "node-yellow" : (Model.estado > 2 ? "node-black" : "node-grey"))"></div>
            <span class="timeline-label @(Model.estado == 2 ? "fw-bold text-dark" : "text-muted")">En Desarrollo</span>
        </div>
        <div class="timeline-step">
            <div class="timeline-node @(Model.estado == 3 ? "node-yellow" : (Model.estado > 3 ? "node-black" : "node-grey"))"></div>
            <span class="timeline-label @(Model.estado == 3 ? "fw-bold text-dark" : "text-muted")">Pruebas Piloto</span>
        </div>
        <div class="timeline-step">
            <div class="timeline-node @(Model.estado == 4 ? "node-yellow" : (Model.estado > 4 ? "node-black" : "node-grey"))"></div>
            <span class="timeline-label @(Model.estado == 4 ? "fw-bold text-dark" : "text-muted")">En Revisión</span>
        </div>
        <div class="timeline-step">
            <div class="timeline-node @(Model.estado == 5 ? "node-yellow" : "node-grey")"></div>
            <span class="timeline-label @(Model.estado == 5 ? "fw-bold text-dark" : "text-muted")">Implementado</span>
        </div>
    </div>

    <details class="tarjeta-details my-4">
        <summary class="btn-ver-mas-container text-start text-md-center">
            <div class="btn-ver-mas d-inline-block">Ver más <span>▼</span></div>
        </summary>
        
        <div class="details-content mt-3 p-4 bg-white border rounded-4">
            <h4 class="fw-bold mb-3 text-dark">Puntos Clave:</h4>
            <ul class="fs-6 mb-4 ms-3">
                @if(Model.puntos_clave != null && Model.puntos_clave.Any())
                {
                    foreach(var punto in Model.puntos_clave)
                    {
                        <li class="mb-2">@punto</li>
                    }
                }
                else
                {
                    <li class="mb-2 text-muted fst-italic">No se definieron puntos clave.</li>
                }
            </ul>

            <hr class="text-muted border-1 opacity-25 my-4">

            <h4 class="fw-bold mb-3 text-dark">Descripción:</h4>
            <p class="fs-6 mb-4 lh-base">@(string.IsNullOrEmpty(Model.descripcion) ? "Sin descripción detallada." : Model.descripcion)</p>
            
            <hr class="text-muted border-1 opacity-25 my-4">

            <h4 class="fw-bold mb-3 text-dark">Colaboradores:</h4>
            <div class="d-flex flex-wrap gap-3">
                @if(Model.colaboradores != null && Model.colaboradores.Any())
                {
                    foreach(var colab in Model.colaboradores)
                    {
                        <div class="colaborador-pill">
                            <img src="@(string.IsNullOrEmpty(colab.foto) ? "/assets/random/user.png" : colab.foto)" alt="@colab.nombre">
                            <span class="fw-bold text-dark">@colab.nombre</span>
                        </div>
                    }
                }
                else
                {
                    <span class="text-muted fs-6">Aún no hay colaboradores en este proyecto.</span>
                }
            </div>
        </div>
        <hr class="text-muted border-1 opacity-25 my-5">

        <div class="d-flex align-items-center mb-4 gap-3">
            <img src="~/assets/random/user.png" alt="Usuario" class="avatar-autora rounded-circle" style="width: 45px; height: 45px;">
            <form method="post" action="/Inicio/GuardarComentario" class="flex-grow-1 m-0 d-flex gap-2">
                <input type="hidden" name="ideaId" value="@Model.idea_id" />
                <input type="text" class="form-control rounded-pill bg-white border border-secondary px-4 py-2 text-dark" name="Mensaje" placeholder="Escribe tu recomendación..." required>
                <button type="submit" class="d-none">Enviar</button>
            </form>
        </div>

        <div class="comentarios-lista">
            @if(Model.comentarios != null && Model.comentarios.Any())
            {
                foreach(var comentario in Model.comentarios)
                {
                    <div class="comentario-item d-flex gap-3 mb-4">
                        <img src="@(string.IsNullOrEmpty(comentario.autor_foto) ? "/assets/random/user.png" : comentario.autor_foto)" alt="Avatar" class="avatar-autora rounded-circle flex-shrink-0" style="width: 45px; height: 45px;">
                        <div class="comentario-contenido flex-grow-1">
                            <div class="d-flex align-items-center mb-2">
                                <span class="fw-bold text-dark fs-5 me-3">@(comentario.autor_nombre ?? "Usuario")</span>
                                <span class="text-muted small fw-bold">• @comentario.dias_transcurridos días</span>
                            </div>
                            <p class="text-dark fs-5 mb-3 lh-sm">@comentario.mensaje</p>
                            <div class="d-flex align-items-center gap-2">
                                <div class="d-flex align-items-center border rounded-pill bg-white px-3 py-1 shadow-sm">
                                    <img src="~/assets/icons/thumbs-up.svg" alt="Like" style="width: 20px; height: 20px;" />
                                    <span class="border-start ms-2 ps-2 fw-bold text-dark">@comentario.likes</span>
                                </div>
                                <div class="d-flex align-items-center border rounded-pill bg-white px-3 py-1 shadow-sm">
                                    <img src="~/assets/icons/thumbs-down.svg" alt="Dislike" style="width: 20px; height: 20px;" />
                                    <span class="border-start ms-2 ps-2 fw-bold text-dark">@comentario.dislikes</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </details>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-4 gap-3">
        <div class="d-flex align-items-center gap-1 contadores-interaccion">
            <form method="post" action="/Inicio/DarLike" class="m-0">
                <input type="hidden" name="ideaId" value="@Model.idea_id" />
                <button type="submit" class="btn-interacciones">
                    <div class="row">
                        <div class="col-6"><img src="~/assets/icons/thumbs-up.svg" class="btn-icon" /></div>
                        <div class="col-6"><span class="fw-bold text-dark fs-5">@(Model.metricas?.likes ?? 0)</span></div>
                    </div>
                </button>
            </form>

            <form method="post" action="/Inicio/DarDislike" class="m-0">
                <input type="hidden" name="ideaId" value="@Model.idea_id" />
                <button type="submit" class="btn-interacciones">
                    <div class="row">
                        <div class="col-6"><img src="~/assets/icons/thumbs-down.svg" class="btn-icon" /></div>
                        <div class="col-6"><span class="fw-bold text-dark fs-5">@(Model.metricas?.dislikes ?? 0)</span></div>
                    </div>
                </button>
            </form>

            <div class="btn-interacciones bg-light mx-auto" style="cursor: default;">
                <div class="row">
                    <div class="col-6"><img src="~/assets/icons/comments.svg" class="btn-icon" /></div>
                    <div class="col-6"><span class="fw-bold text-dark fs-5">@(Model.metricas?.cantidad_comentarios ?? Model.comentarios?.Count ?? 0)</span></div>
                </div>
            </div>
        </div>
        
        <form method="post" action="/Inicio/UnirseProyecto" class="m-0 align-self-start align-self-md-center">
            <input type="hidden" name="ideaId" value="@Model.idea_id" />
            <button type="submit" class="btn btn-unirme rounded-pill fw-bold fs-5 py-2 px-4">Unirme al Proyecto</button>
        </form>
    </div>
</div>