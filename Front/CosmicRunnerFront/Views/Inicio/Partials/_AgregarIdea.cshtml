@model CosmicRunnerFront.Models.InicioModels.FormularioIdeaViewModel
<details class="agregar-idea-desplegable">
    
    <summary class="btn-agregar-trigger">
        <div class="btn btn-agregar rounded-pill px-4 py-2 shadow-sm">
            + Agrega tu Idea
        </div>
    </summary>

    <div class="clearfix"></div>

    <div class="contenedor-formulario-inline mt-4 p-4 p-md-5 border rounded-4 bg-white text-start shadow-sm w-100">
        <h4 class="fw-bold mb-4 text-dark border-bottom pb-2">Nueva Iniciativa</h4>
        
        <form method="post" action="/Inicio/CrearIdea">
            <div class="mb-4">
                <label class="form-label fw-bold text-muted small">Título del Proyecto</label>
                <input type="text" class="form-control form-control-lg border border-secondary rounded-3 fs-6" asp-for="titulo" placeholder="Ej. Optimización de Planta...">
                <span asp-validation-for="titulo" class="text-danger small fw-bold"></span>
            </div>
            
            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted small">Departamento de Origen</label>
                    <select class="form-select border border-secondary rounded-3 text-dark" asp-for="departamento_id" asp-items="Model.CatalogoDepartamentos">
                        <option value="">-- Selecciona un departamento --</option>
                    </select>
                    <span asp-validation-for="departamento_id" class="text-danger small fw-bold"></span>
                </div>
                <div class="col-md-6 mt-3 mt-md-0">
                    <label class="form-label fw-bold text-muted small">Área de Impacto</label>
                    <select class="form-select border border-secondary rounded-3 text-dark" asp-for="area_impacto_id" asp-items="Model.CatalogoAreasImpacto">
                        <option value="">-- Selecciona un area --</option>
                    </select>
                    <span asp-validation-for="area_impacto_id" class="text-danger small fw-bold"></span>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-muted small">Resumen de la Idea (3 puntos)</label>
                <input type="text" class="form-control border border-secondary mb-2 rounded-3" asp-for="punto_1" placeholder="1. Punto clave...">
                <span asp-validation-for="punto_1" class="text-danger small fw-bold d-block mb-2"></span>
                
                <input type="text" class="form-control border border-secondary mb-2 rounded-3" asp-for="punto_2" placeholder="2. Punto clave...">
                <span asp-validation-for="punto_2" class="text-danger small fw-bold d-block mb-2"></span>
                
                <input type="text" class="form-control border border-secondary mb-3 rounded-3" asp-for="punto_3" placeholder="3. Punto clave...">
                <span asp-validation-for="punto_3" class="text-danger small fw-bold d-block mb-3"></span>
                
                <label class="form-label fw-bold text-muted small mt-2">Descripción Detallada</label>
                <textarea class="form-control border border-secondary rounded-3" asp-for="descripcion" rows="4" placeholder="Explica tu propuesta..."></textarea>
                <span asp-validation-for="descripcion" class="text-danger small fw-bold"></span>
            </div>
            
            <div class="row mt-4">
                <div class="col-12 col-md-4 d-flex justify-content-start mb-3 mb-md-0">
                    <a href="/Inicio/LimpiarFormulario" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-bold shadow-sm w-100 w-md-auto text-decoration-none">
                        Limpiar
                    </a>
                </div>
                
                <div class="col-12 col-md-8 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light border rounded-pill px-4 py-2 fw-bold shadow-sm text-muted" onclick="this.closest('details').removeAttribute('open');">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-agregar rounded-pill px-5 py-2 fw-bold shadow-sm">
                        Publicar
                    </button>
                </div>
            </div>
        </form>
    </div>
</details>