@using CosmicRunnerFront.DataInicio
@model CosmicRunnerFront.Models.InicioModels.Idea

<details class="agregar-idea-desplegable">
    
    <summary class="btn-agregar-trigger float-end">
        <div class="btn btn-agregar rounded-pill px-4 py-2 shadow-sm">
            + Agrega tu Idea
        </div>
    </summary>

    <div class="clearfix"></div>

    <div class="contenedor-formulario-inline mt-4 p-4 p-md-5 border rounded-4 bg-white text-start shadow-sm w-100">
        <h4 class="fw-bold mb-4 text-dark border-bottom pb-2">Nueva Iniciativa</h4>
        
        <form method="post" action="/Inicio/CrearIdea">
            <div class="mb-4">
                <label class="form-label fw-bold text-muted small">Título del Proyecto</label>
                <input type="text" class="form-control form-control-lg rounded-3 fs-6" name="Titulo" required placeholder="Ej. Optimización de Planta...">
            </div>
            
            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted small">Departamento de Origen</label>
                    <select class="form-select rounded-3 text-dark" name="DepartamentoId" required>
                        <option value="" disabled selected>Selecciona un departamento...</option>
                        @foreach(var depto in MockDatabase.Departamentos) {
                            <option value="@depto.Id">@depto.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 mt-3 mt-md-0">
                    <label class="form-label fw-bold text-muted small">Área de Impacto</label>
                    <select class="form-select rounded-3 text-dark" name="AreaImpactoId" required>
                        <option value="" disabled selected>Selecciona un área...</option>
                        @foreach(var area in MockDatabase.AreasImpacto) {
                            <option value="@area.Id">@area.Nombre</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-muted small">Resumen de la Idea (3 puntos)</label>
                <input type="text" class="form-control mb-2 rounded-3" name="PuntosClave[0]" placeholder="1. Punto clave..." required>
                <input type="text" class="form-control mb-2 rounded-3" name="PuntosClave[1]" placeholder="2. Punto clave..." required>
                <input type="text" class="form-control mb-3 rounded-3" name="PuntosClave[2]" placeholder="3. Punto clave..." required>
                
                <label class="form-label fw-bold text-muted small mt-2">Descripción Detallada</label>
                <textarea class="form-control rounded-3" name="Descripcion" rows="4" placeholder="Explica tu propuesta..." required></textarea>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-agregar rounded-pill px-5 py-2 fw-bold shadow-sm">Publicar</button>
            </div>
        </form>
    </div>
</details>