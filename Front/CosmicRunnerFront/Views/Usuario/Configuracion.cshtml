@model CosmicRunnerFront.Models.UsuarioModels.UsuarioViewModel

@{
    ViewData["Title"] = "Configuración";
}

@section Styles {
    <link rel="stylesheet" href="~/css/usuario.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/usuario-configuracion.js" asp-append-version="true"></script>
}

<section class="usuario-panel" aria-label="Panel de perfil">
    @if (Model.EsPerfilPropio)
    {
        <a class="usuario-panel-action" asp-controller="Usuario" asp-action="Configuracion" aria-label="Configuración">
            <img src="~/assets/icons/gear.svg" alt="" />
            <span>Configuración</span>
        </a>
    }

    <div class="usuario-top">
        <div class="usuario-avatar-shell">
            <img class="usuario-avatar" src="@Url.Content(Model.FotoPerfilUrl)" alt="Foto del usuario" />
        </div>

        <div class="usuario-headlines">
            <h1 class="usuario-nombre">@Model.NombreCompleto</h1>
            <p class="usuario-rol">@Model.Puesto</p>
            <p class="usuario-area">@Model.Departamento</p>
        </div>
    </div>

    <div class="usuario-tabs" role="tablist" aria-label="Secciones del perfil">
        @foreach (var seccion in Model.Secciones)
        {
            if (seccion.Accion != "Configuracion")
            {
                <a class="tab-pill @(Model.SeccionActiva == seccion.Accion ? "tab-pill-active" : "")" asp-controller="Usuario" asp-action="@seccion.Accion">@seccion.Etiqueta</a>
            }
        }
    </div>

    <form id="configForm" class="config-layout" asp-controller="Usuario" asp-action="GuardarConfiguracion" method="post" novalidate>
        <input type="hidden" asp-for="Usuario.Id" />
        <input type="hidden" asp-for="Usuario.Ubicacion" />
        <input type="hidden" asp-for="Usuario.FotoPerfilUrl" />
        <input type="hidden" asp-for="Usuario.Biografia" />
        <input type="hidden" asp-for="Usuario.DepartamentoId" />

        <section class="config-section">
            <div class="config-section-header">
                <div>
                    <h2>Datos Personales</h2>
                </div>
            </div>

            <div class="config-field-grid">
                <label class="config-field">
                    <span>Nombre(s)</span>
                    <input type="text" id="Nombre" asp-for="Usuario.Nombre" />
                    <span id="errorNombre" class="config-inline-error" aria-live="polite"></span>
                </label>
                <label class="config-field">
                    <span>Apellido(s)</span>
                    <input type="text" id="Apellido" asp-for="Usuario.Apellido" />
                    <span id="errorApellido" class="config-inline-error" aria-live="polite"></span>
                </label>
                <label class="config-field">
                    <span>Puesto de Trabajo</span>
                    <input type="text" id="Puesto" asp-for="Usuario.Puesto" />
                    <span id="errorPuesto" class="config-inline-error" aria-live="polite"></span>
                </label>
                <label class="config-field">
                    <span>Teléfono</span>
                    <input type="text" id="Telefono" asp-for="Usuario.Telefono" />
                    <span id="errorTelefono" class="config-inline-error" aria-live="polite"></span>
                </label>
                <label class="config-field">
                    <span>Correo Electrónico</span>
                    <input type="email" id="Correo" asp-for="Usuario.Correo" />
                    <span id="errorCorreo" class="config-inline-error" aria-live="polite"></span>
                </label>
                <label class="config-field">
                    <span>Área/Departamento</span>
                    <input type="text" id="Departamento" value="@Model.Departamento" readonly />
                    <span id="errorDepartamento" class="config-inline-error" aria-live="polite"></span>
                </label>
            </div>
        </section>

        <section class="config-section config-section-wide">
            <div class="config-section-header">
                <div>
                    <h2>Habilidades e Información</h2>
                </div>
            </div>

            <div class="skills-grid config-skills-grid">
                @for (var i = 0; i < Model.Habilidades.Count; i++)
                {
                    var habilidad = Model.Habilidades[i];
                    <span class="skill-chip">@habilidad</span>
                }
            </div>
            <span id="errorHabilidades" class="config-inline-error" aria-live="polite"></span>

            <input type="hidden" id="Habilidades" name="HabilidadesTexto" value="@string.Join("|", Model.Habilidades)" />

            <div class="config-ability-editor">
                <label class="config-field config-field-inline">
                    <span>Selecciona una habilidad</span>
                    <div class="config-inline-row">
                        <select id="habilidadSelect">
                            <option value="">Seleccionar</option>
                            <option>Eficiencia</option>
                            <option>Liderazgo</option>
                            <option>Calidad</option>
                            <option>Comunicación</option>
                            <option>Planeación</option>
                            <option>Trabajo en equipo</option>
                        </select>
                        <button type="button" id="addSkillButton" class="config-icon-button" aria-label="Agregar habilidad">+</button>
                    </div>
                </label>

                <label class="config-field config-about-field">
                    <div class="config-inline-row">
                        <span class="config-about-inline-text">Acerca de Mí</span>
                        <button type="button" class="config-icon-button" data-bs-toggle="modal" data-bs-target="#aboutMeModal" aria-label="Editar Acerca de Mí">
                            <img src="~/assets/icons/pencil.svg" alt="" />
                        </button>
                    </div>
                </label>
            </div>
            <span id="errorBiografia" class="config-inline-error" aria-live="polite"></span>

        </section>

        <section class="config-section">
            <div class="config-section-header">
                <div>
                    <h2>Preferencia de Interfaz</h2>
                </div>
            </div>

            <div class="config-field-grid config-field-grid-single">
                <label class="config-field">
                    <span>Tema</span>
                    <select id="Tema" asp-for="Usuario.Tema">
                        <option value="Claro">Claro</option>
                        <option value="Oscuro">Oscuro</option>
                    </select>
                    <span id="errorTema" class="config-inline-error" aria-live="polite"></span>
                </label>
            </div>
        </section>

        <div class="config-actions">
            <button type="button" id="discardChangesButton" class="config-secondary-button">Descartar Cambios</button>
            <button type="button" id="saveChangesButton" class="config-primary-button">Guardar Cambios</button>
        </div>
    </form>
</section>

<div class="modal fade" id="aboutMeModal" tabindex="-1" aria-labelledby="aboutMeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content config-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="aboutMeModalLabel">Editar Acerca de Mí</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <label class="config-field config-field-modal">
                    <span>Texto de presentación</span>
                    <textarea id="aboutEditor" rows="5">@Model.Biografia</textarea>
                </label>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="config-secondary-button" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="saveAboutButton" class="config-primary-button">Guardar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmSaveModal" tabindex="-1" aria-labelledby="confirmSaveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content config-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="confirmSaveModalLabel">Confirmar guardado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">¿Estás seguro que quieres guardar los cambios realizados?</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="config-secondary-button" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="confirmSaveButton" class="config-primary-button">Guardar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmDiscardModal" tabindex="-1" aria-labelledby="confirmDiscardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content config-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="confirmDiscardModalLabel">Confirmar descarte</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">¿Deseas descartar los cambios realizados?</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="config-secondary-button" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="confirmDiscardButton" class="config-primary-button">Descarta</button>
            </div>
        </div>
    </div>
</div>