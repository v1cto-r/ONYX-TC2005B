@model CosmicRunnerFront.Models.TiendaModels.TiendaViewModel

@{
    ViewData["Title"] = "Tienda";

    var mensajeTienda = TempData["MensajeTienda"]?.ToString();
    var tipoMensajeTienda = TempData["TipoMensajeTienda"]?.ToString();
    var productoNombre = TempData["ProductoNombre"]?.ToString();
    var productoCategoria = TempData["ProductoCategoria"]?.ToString();
    var productoImagen = TempData["ProductoImagen"]?.ToString();
    var productoPrecio = TempData["ProductoPrecio"]?.ToString();
    var creditosRestantes = TempData["CreditosRestantes"]?.ToString();
}

@section Styles {
    <link rel="stylesheet" href="~/css/Tienda/tienda.css" />
}

<div class="tienda-page">

    @* Encabezado principal de la tienda *@
    <section class="tienda-header">
        <div>
            <p class="tienda-eyebrow">Cosmic Runner</p>
            <h1>Tienda de recompensas</h1>
            <p class="tienda-description">
                Canjea tus créditos por cosméticos del jugador, cosméticos de la nave e íconos para tu cuenta.
            </p>
        </div>

        <div class="creditos-card">
            <span>Créditos disponibles</span>
            <strong>@Model.CreditosUsuario.ToString("N0")</strong>
        </div>
    </section>

    @* Formulario para buscar y filtrar productos *@
    <section class="tienda-controls">
        <form asp-action="Index" method="get" class="tienda-filter-form">
            <div class="tienda-search">
                <label for="SearchText">Buscar producto</label>
                <div class="tienda-search-box">
                    <input
                        type="text"
                        id="SearchText"
                        name="SearchText"
                        value="@Model.SearchText"
                        placeholder="Buscar por nombre o tipo..." />

                    <button type="submit">
                        <img src="~/assets/icons/search.svg" alt="Buscar" />
                    </button>
                </div>
            </div>

            <div class="tienda-category">
                <label for="FilterCategoriaId">Filtrar por categoría</label>
                <select id="FilterCategoriaId" name="FilterCategoriaId" onchange="this.form.submit()">
                    <option value="">Todas</option>

                    @foreach (var categoria in Model.Categorias)
                    {
                        <option value="@categoria.Id" selected="@(Model.FilterCategoriaId == categoria.Id)">
                            @categoria.Nombre
                        </option>
                    }
                </select>
            </div>

            <a asp-action="Index" class="tienda-clear-filter">
                Limpiar filtros
            </a>
        </form>
    </section>

    @* Lista de productos disponibles *@
    <section class="tienda-products">
        @if (Model.Productos.Any())
        {
            foreach (var producto in Model.Productos)
            {
                <article class="producto-card">
                    <div class="producto-img-wrapper">
                        <img src="@producto.ImagenUrl" alt="@producto.Nombre" />
                    </div>

                    <div class="producto-content">
                        <span class="producto-categoria">@producto.CategoriaNombre</span>
                        <h3>@producto.Nombre</h3>
                        <p>@producto.Descripcion</p>
                    </div>

                    <div class="producto-footer">
                        <div class="producto-precio">
                            <span>Precio</span>
                            <strong>@producto.Precio.ToString("N0") créditos</strong>
                        </div>

                        @* Cambiamos el boton segun el estado del producto *@
                        @if (producto.Comprado)
                        {
                            <button type="button" class="producto-button producto-button-disabled" disabled>
                                Comprado
                            </button>
                        }
                        else if (!producto.Disponible)
                        {
                            <button type="button" class="producto-button producto-button-disabled" disabled>
                                No disponible
                            </button>
                        }
                        else
                        {
                            <button
                                type="button"
                                class="producto-button js-open-product"
                                data-bs-toggle="modal"
                                data-bs-target="#detalleProductoModal"
                                data-producto-id="@producto.Id"
                                data-producto-nombre="@producto.Nombre"
                                data-producto-descripcion="@producto.Descripcion"
                                data-producto-categoria="@producto.CategoriaNombre"
                                data-producto-precio="@producto.Precio"
                                data-producto-imagen="@producto.ImagenUrl"
                                data-creditos="@Model.CreditosUsuario">
                                Adquirir
                            </button>
                        }
                    </div>
                </article>
            }
        }
        else
        {
            <div class="tienda-empty">
                <h3>No se encontraron productos</h3>
                <p>Intenta cambiar la búsqueda o seleccionar otra categoría.</p>
            </div>
        }
    </section>
</div>

@* Detalles del producto antes de comprar *@
<div class="modal fade" id="detalleProductoModal" tabindex="-1" aria-labelledby="detalleProductoTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content tienda-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="detalleProductoTitle">Detalle del producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div class="detalle-grid">
                    <div class="detalle-image-box">
                        <img id="modalProductoImagen" src="" alt="Producto seleccionado" />
                    </div>

                    <div class="detalle-info">
                        <span id="modalProductoCategoria" class="producto-categoria"></span>
                        <h2 id="modalProductoNombre"></h2>
                        <p id="modalProductoDescripcion"></p>

                        <div class="detalle-data">
                            <div>
                                <span>Precio</span>
                                <strong id="modalProductoPrecio"></strong>
                            </div>

                            <div>
                                <span>Créditos actuales</span>
                                <strong id="modalCreditosActuales"></strong>
                            </div>

                            <div>
                                <span>Créditos restantes</span>
                                <strong id="modalCreditosRestantes"></strong>
                            </div>
                        </div>

                        <div id="modalCompraMensaje" class="detalle-warning d-none">
                            No tienes créditos suficientes para comprar este producto.
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="tienda-modal-cancel" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button
                    type="button"
                    id="btnAbrirConfirmacion"
                    class="tienda-modal-action">
                    Comprar ahora
                </button>
            </div>
        </div>
    </div>
</div>

@* Confirmar la compra *@
<div class="modal fade" id="confirmarCompraModal" tabindex="-1" aria-labelledby="confirmarCompraTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content tienda-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmarCompraTitle">Confirmar compra</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <p class="confirm-text">
                    ¿Estás seguro de que deseas comprar este producto?
                </p>

                <div class="confirm-product-box">
                    <strong id="confirmProductoNombre"></strong>
                    <span id="confirmProductoPrecio"></span>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="tienda-modal-cancel" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <form asp-action="Comprar" method="post">
                    <input type="hidden" id="confirmProductoId" name="productoId" />
                    <button type="submit" class="tienda-modal-action">
                        Confirmar compra
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@* Muestra si la compra salio bien o si hubo algun problema *@
@if (!string.IsNullOrEmpty(mensajeTienda))
{
    <div class="modal fade" id="mensajeTiendaModal" tabindex="-1" aria-labelledby="mensajeTiendaTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content tienda-modal resultado-modal">
                <div class="modal-header resultado-modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body resultado-modal-body">
                    @if (tipoMensajeTienda == "success")
                    {
                        <div class="resultado-icono resultado-icono-success">
                            ✓
                        </div>

                        <h2 id="mensajeTiendaTitle">Compra realizada con éxito</h2>
                        <p>El artículo fue agregado a tu cuenta. Podrás verlo disponible dentro del juego.</p>

                        <div class="resultado-producto">
                            <img src="@productoImagen" alt="@productoNombre" />

                            <div>
                                <h3>@productoNombre</h3>
                                <span>@productoCategoria</span>

                                <strong>
                                    @Convert.ToInt32(creditosRestantes).ToString("N0") créditos restantes
                                </strong>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="resultado-icono resultado-icono-error">
                            !
                        </div>

                        <h2 id="mensajeTiendaTitle">No se pudo completar la compra</h2>
                        <p>@mensajeTienda</p>
                    }
                </div>

                <div class="modal-footer resultado-modal-footer">
                    <button type="button" class="tienda-modal-action resultado-button-full" data-bs-dismiss="modal">
                        Continuar comprando
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/Tienda/tienda.js"></script>
}